# Copy to .env only if you do not already have one. Never commit real credentials.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=atmosync-sensor-data

# Required only for Kafka -> Snowflake ingestion; use your own provisioned resources.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
